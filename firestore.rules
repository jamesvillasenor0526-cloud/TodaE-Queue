rules_version = '2';

// Changes from the previous ruleset (kept in firestore.rules.backup):
//
//   1. Adds the `tickets` collection. It was missing entirely, so every
//      support ticket write and read fell through to the default deny —
//      passengers and drivers could not submit tickets and the admin
//      dashboard could not list them.
//   2. A user can no longer grant themselves approval. `isVerified`,
//      `verificationStatus` and `role` are now only writable by an admin,
//      which is how driver approval is meant to work.
//   3. A signed-in user can no longer edit or delete *other* people's
//      records. Document deletes are off everywhere — neither the app nor
//      the admin dashboard deletes documents (the only `.delete()` calls
//      are FieldValue.delete() on individual fields).
//
// Deliberately unchanged: queueEntries and bookings stay broadly writable
// by any signed-in user. With no backend intermediary, a passenger's client
// writes into a driver's queue entry during dispatch, and both parties
// write different fields on the same booking. Narrowing those safely needs
// Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins are identified by the role on their own user document.
    // Costs one extra read, so callers put the cheaper self-check first.
    //
    // The exists() guard matters: without it, a signed-in user who has no
    // users/{uid} document makes this throw rather than return false, which
    // shows up as an evaluation error instead of a clean deny.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') in ['toda_admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') == 'super_admin';
    }

    // Only the super admin makes or unmakes admins. A TODA admin approving
    // drivers changes isVerified, never role; before this, one could create
    // or promote anyone to any role, super_admin included.
    function roleChangeAllowed() {
      return isSuperAdmin()
        || request.resource.data.get('role', '')
             == resource.data.get('role', '');
    }

    function newRoleAllowed() {
      return isSuperAdmin()
        || request.resource.data.get('role', 'passenger')
             in ['passenger', 'driver'];
    }

    // The booking a rating is for, and whether it has ended.
    function bookingOf(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function bookingEnded(b) {
      return b.get('tripStatus', '') == 'TRIP_COMPLETED'
        || b.get('status', '') == 'completed';
    }

    // Approval, role and whether the account is enabled must survive a
    // self-update untouched — a disabled driver cannot switch themselves
    // back on.
    //
    // Read with get(): a profile missing one of these fields — four of the
    // live ones lack verificationStatus — made the comparison an error, and
    // an error denies, so those people could not save anything on their own
    // profile at all.
    function keepsApprovalFields() {
      return request.resource.data.get('isVerified', null) == resource.data.get('isVerified', null)
        && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('isActive', true) == resource.data.get('isActive', true);
    }

    // Terminals — public read so the registration screen can list them
    // before the user has an account. Written only by admins: any signed-in
    // user, passengers included, could add, move or delete a terminal. No
    // app or dashboard screen writes terminals; they are set up from the
    // Firebase console, which these rules do not restrict.
    match /terminals/{terminalId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Users — the public half of a profile: name, photo, rating, role,
    // approval state, and a driver's GCash QR so a passenger can pay them.
    // Read across roles, because both sides of a trip need to see who they
    // are dealing with.
    //
    // What is NOT here any more: phone, email, ID photo and selfie. Those
    // moved to the private subdocument below, because every signed-in
    // account could read all 82 user records — 78 phone numbers and 14
    // government ID photographs — by asking for the collection.
    match /users/{userId} {
      allow read: if signedIn();

      // Self-registration cannot arrive pre-approved, and cannot mint an
      // admin. Admins may also create a user record.
      allow create: if (signedIn()
                        && request.auth.uid == userId
                        && request.resource.data.get('isVerified', false) == false
                        && request.resource.data.get('role', 'passenger')
                             in ['passenger', 'driver'])
                    || (isAdmin() && newRoleAllowed());

      // Own profile minus the approval fields, or an admin (this is the
      // path driver approval goes through).
      allow update: if (signedIn()
                        && request.auth.uid == userId
                        && keepsApprovalFields())
                    || (isAdmin() && roleChangeAllowed());

      allow delete: if false;

      // Phone, email, ID photograph, selfie. The owner and the admins who
      // verify them — nobody else, ever. A trip's two parties exchange
      // phone numbers through the booking instead, which only they and an
      // admin can read.
      match /private/{docId} {
        allow read, create, update: if signedIn()
          && (request.auth.uid == userId || isAdmin());
        allow delete: if false;
      }
    }

    // Every user's private record at once — how the dashboard lists drivers'
    // phones, ID photographs and selfies. A query across all of them is
    // judged by this rule, not the one nested under users/{userId} above:
    // without it the dashboard's list was refused outright and every driver
    // showed "No ID Photo". Admins only, reading only.
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    // A driver's place in a terminal's queue.
    //
    // Fair first-come order is the point of the whole system, so the three
    // ways it could be rigged are closed here rather than only in the app:
    //
    //   * you may only create your own entry, so nobody adds one for
    //     someone else;
    //   * checkedInAt must be the server's clock, so nobody backdates
    //     themselves to the front of the line;
    //   * an unapproved driver cannot join at all. The app blocks this in
    //     two places, but a modified client ignored both.
    //
    // Updates stay wider than creates on purpose: dispatch is written by
    // the *passenger's* client into the driver's entry, and until that
    // moves to a Cloud Function no rule can tell a real dispatch from a
    // forged one. What it can do is stop a rival cancelling someone's
    // place, which is the damaging case: only the entry's own driver, or
    // an admin, may take it out of the queue.
    match /queueEntries/{entryId} {
      // Approved, and not disabled from the dashboard. Checked here so a
      // disabled driver cannot rejoin the queue from an app that predates
      // the disabled screen.
      function isApprovedDriver() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('isVerified', false) == true
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('isActive', true) != false;
      }

      function mine() {
        return resource.data.get('driverId', '') == request.auth.uid;
      }

      // Leaving the queue, or being taken out of it.
      function givingUpAPlace() {
        return request.resource.data.get('status', '')
                 in ['cancelled', 'completed']
          && resource.data.get('status', '') != request.resource.data.get('status', '');
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && isApprovedDriver()
        && request.resource.data.status == 'waiting'
        && request.resource.data.checkedInAt == request.time;

      allow update: if signedIn()
        && (mine() || isAdmin() || !givingUpAPlace());

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      // Read by the two people on the trip and by admins. Every signed-in
      // account could previously read every booking in the database: who
      // travelled with whom, from which address to which, and what they
      // paid. It also has to close before the two parties can exchange
      // phone numbers through the booking, which is what replaces reading
      // them out of the user directory.
      //
      // Every query the apps make is either a single booking by id or
      // filtered to the caller's own passengerId or driverId, so nothing
      // legitimate needs the wider access.
      allow read: if signedIn()
        && (resource.data.get('passengerId', '') == request.auth.uid
            || resource.data.get('driverId', '') == request.auth.uid
            || isAdmin());

      // Writes stay open, and this is the audit's largest remaining hole:
      // dispatch is written by the passenger's client into a booking that
      // does not exist yet, and both apps write different fields on the
      // same document throughout the trip. Separating a real dispatch from
      // a forged one needs a Cloud Function.
      allow create, update: if signedIn();
      allow delete: if false;

      // Messages between the driver and the passenger of this trip.
      //
      // Narrower than the booking above deliberately: a booking is written
      // by both apps in ways no rule can safely separate yet, but a message
      // has exactly one author and two readers, and it is the one place in
      // the app where people talk to each other. Nobody else reads it —
      // except an admin, who has to be able to look into a complaint.
      //
      // Nothing may be edited or deleted, by anyone. A thread is evidence:
      // a passenger reporting harassment must not find the words gone.
      match /messages/{messageId} {
        function partyToTrip() {
          return bookingOf(bookingId).get('driverId', '') == request.auth.uid
            || bookingOf(bookingId).get('passengerId', '') == request.auth.uid;
        }

        allow read: if signedIn() && (partyToTrip() || isAdmin());

        allow create: if signedIn()
          && partyToTrip()
          // The author is whoever is signed in — you cannot write as the
          // other person.
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['driver', 'passenger']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }
    }

    // Ratings — one per trip, by that trip's passenger, once it has ended.
    // The rating's id is the booking's, so a second submission is an update
    // and refused, rather than a duplicate: two trips in the database were
    // rated twice, because the old dialog failed after saving and was sent
    // again. Before this anyone could rate any driver, any number of times.
    match /ratings/{ratingId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && ratingId == request.resource.data.bookingId
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && bookingOf(ratingId).get('passengerId', '') == request.auth.uid
        && bookingOf(ratingId).get('driverId', '')
             == request.resource.data.driverId
        && bookingEnded(bookingOf(ratingId));

      // The rated driver may reply, and change nothing else.
      allow update: if (signedIn()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['driverReply', 'repliedAt']))
        || isAdmin();

      allow delete: if false;
    }

    // SOS alerts.
    //
    // Raised by the person they are about, kept current and called off by
    // them, acknowledged and resolved by an admin. Until now any signed-in
    // user could rewrite any alert — resolve someone else's, mark it as
    // answered, or change whose it was.
    //
    // Creating stays as open as it safely can: an SOS must never be refused
    // for a missing optional field.
    match /sosAlerts/{alertId} {
      // Read by the person it is about and by the admins who answer it —
      // nobody else. Any signed-in account could previously read every
      // alert in the database, its coordinates and its recorded path,
      // including silent alerts raised by someone who could not be seen
      // asking for help. The one feature meant to protect people was
      // showing an abuser with an account where they were.
      allow read: if signedIn()
        && (resource.data.get('userId', '') == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';

      // The owner may update their own alert — its location while it is open,
      // the trip attached a moment after raising it — and call it off. Older
      // app versions call it off by writing 'resolved', so that stays allowed.
      // They may not claim an admin has responded or brought in emergency
      // services, nor hand the alert to someone else. Admins may update any
      // alert.
      allow update: if (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && (request.resource.data.status == resource.data.status
              || request.resource.data.status in ['cancelled', 'resolved'])
          && request.resource.data.get('acknowledgedBy', null)
               == resource.data.get('acknowledgedBy', null)
          && request.resource.data.get('resolvedBy', null)
               == resource.data.get('resolvedBy', null)
          && request.resource.data.get('escalatedBy', null)
               == resource.data.get('escalatedBy', null))
        || isAdmin();

      // A record of who asked for help, and when, is never erased.
      allow delete: if false;
    }

    // Settings everyone reads and only a super admin writes — the fare
    // rates, today. Fares move with fuel prices and the local ordinance, so
    // they cannot be constants in a build; but they decide what a passenger
    // is charged, so the limits are enforced here and not only in the form.
    // A trip keeps the fare it was booked at regardless: that figure is
    // written onto the booking.
    match /settings/{settingId} {
      function withinLimits() {
        let d = request.resource.data;
        // No pick-up fee: it was never charged, and has been removed.
        return d.minimumFare is number && d.minimumFare >= 5 && d.minimumFare <= 200
          && d.ratePerKm is number && d.ratePerKm >= 1 && d.ratePerKm <= 100;
      }

      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        && settingId == 'fare'
        && withinLimits();
      allow delete: if false;

      // Who changed the rates, when, and what they were before. Fares are
      // regulated, so the record of a change is kept and cannot be rewritten
      // or removed — by anyone, the admin who made it included.
      match /history/{changeId} {
        allow read: if isAdmin();
        allow create: if isSuperAdmin()
          && request.resource.data.changedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // A receipt is the record of a fare paid. Anyone could previously
    // write one, or edit an existing one's amount and number.
    //
    // Its id is the booking's, so the trip it belongs to is known and both
    // parties can be checked. Either may bring one into being — the
    // passenger's screen heals a missing receipt when they open the trip,
    // the driver's does the same on payment — but once written the amounts
    // are fixed, and only the driver may mark the money received.
    match /receipts/{receiptId} {
      function partyToReceipt() {
        return bookingOf(receiptId).get('driverId', '') == request.auth.uid
          || bookingOf(receiptId).get('passengerId', '') == request.auth.uid;
      }

      allow read: if signedIn() && (partyToReceipt() || isAdmin());

      allow create: if signedIn()
        && partyToReceipt()
        && request.resource.data.bookingId == receiptId;

      // Only the driver confirming the money arrived, and nothing else.
      allow update: if (signedIn()
          && bookingOf(receiptId).get('driverId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['driverConfirmed', 'confirmedAt']))
        || isAdmin();

      allow delete: if false;
    }

    // Crowd-sourced traffic and incident reports.
    //
    // This collection is new, so unlike queueEntries/bookings there is no
    // legacy client to accommodate and the rules can be written tight from
    // the start: a report is anonymous to nobody, cannot be filed on someone
    // else's behalf, and cannot be rewritten into a different claim after
    // the fact.
    match /reports/{reportId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.confirmations == 0
        && request.resource.data.cleared == false
        && request.resource.data.type is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;

      // Anyone signed in may corroborate a report, but what it says, where
      // it is and who filed it are fixed once written. Only the reporter or
      // an admin may take it down, and only an admin may rule on whether an
      // incident is confirmed or rejected — otherwise the verification
      // system would be worthless, since a reporter could simply mark their
      // own report confirmed. Corroboration by others is the only way a
      // report gets promoted from the app.
      allow update: if signedIn()
        && request.resource.data.type == resource.data.type
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.get('status', '')
              == resource.data.get('status', '')
            || isAdmin())
        && (request.resource.data.cleared == resource.data.cleared
            || resource.data.reportedBy == request.auth.uid
            || isAdmin());

      allow delete: if false;
    }

    // Support tickets — often a complaint about another person, sometimes
    // about harassment. Read by their author and by admins, not by every
    // signed-in user as before.
    match /tickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.get('userId', '') == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000;

      // Answering and closing a ticket is an admin's job.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Default — deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
